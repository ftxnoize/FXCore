<library>
	<name>g_filter_curve</name>
	<desc>Library of common filters and power curves for the FXCore DSP from Experimental Noize</desc>
	<lib_color>102, 52, 76</lib_color>
	<lib_text_color>255,255,255</lib_text_color>
	<sub>
		<name>lp_hp</name>
		<desc>IIR low pass and high pass filter using MREGs for in, out and K</desc>
		<param>
			<name>in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding input signal</desc>
		</param>
		<param>
			<name>k</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding filter frequency coefficient, range 0 to 1.0</desc>
		</param>
		<param>
			<name>hp</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG holding high pass output</desc>
		</param>
		<param>
			<name>lp</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG holding low pass output, do not overwrite/change</desc>
		</param>
		<code>
			/****************************************************
			*        IIR low pass and high pass filter using MREGs 
			*        for in, out and K
			*****************************************************/
			cpy_cm	r0, lp
			cpy_cm	r1, in
			subs	r1, r0		; HP = in - LP
			cpy_mc	hp, acc32	; save HP
			cpy_cm	r2, k
			multrr	r2, acc32	; *k
			multri	acc32, 0.95	; really want to limit to 0.5Fs whic is about K=0.95
			adds	r0, acc32	; LP + (in-LP)*K
			cpy_mc	lp, acc32	; save it
		</code>
	</sub>
	<sub>
		<name>svf</name>
		<desc>State variable filter using MREGs for in, out and controls</desc>
		<param>
			<name>sig_in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG to hold input signal to filter</desc>
		</param>
		<param>
			<name>freq</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG to control frequency point of filter, range 0 to 1.0</desc>
		</param>
		<param>
			<name>q</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG to control Q of filter, range 0 to 1.0</desc>
		</param>
		<param>
			<name>in_lp</name>
			<side>B</side>
			<type>MREG</type>
			<desc>MREG to hold input low-pass filter, not controled by freq or q, do not overwrite/change</desc>
		</param>
		<param>
			<name>bp</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG to hold band-pass filter, do not overwrite/change</desc>
		</param>
		<param>
			<name>lp</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG to hold low-pass filter, do not overwrite/change</desc>
		</param>
		<param>
			<name>hp</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG to hold high-pass filter</desc>
		</param>
		<param>
			<name>notch</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG to hold notch filter</desc>
		</param>
		<code>
			/****************************************************
			*        State variable filter using MREGs for in,  
			*        out and controls
			*****************************************************/
			cpy_cm r7, freq
			cpy_cm r8, q	; actually this is D,which is 1/Q so invert pot sweep to make it act like a Q control
			wrdld acc32, 0x7fff ; put almost 1.0 into acc32
			ori acc32, 0xffff ; don't forget the LSBs
			subs acc32, r8 ; 1-pot in acc32
			cpy_cc r8, acc32
			cpy_cm r0, sig_in ; read in0 into temp
			sra r0, 1 ; in/2
			cpy_cc r0, acc32 ; save to temp
			cpy_cm r2, in_lp
			adds acc32, r2 ; in/2 + input LP
			cpy_cc r1, acc32 ; input to SVF in temp2
			cpy_mc in_lp, r0 ; save in/2 to input LP
			cpy_cm r4, bp
			multrr r8, r4 ; Kd * BP
			subs r1, acc32 ; input - Kd*BP, this is the notch
			cpy_cc r5, acc32 ; save notch result
			multrr r7, r4 ; Kf * BP
			cpy_cm r3, lp
			adds r3, acc32 ; + LP
			cpy_cc r3, acc32 ; save to LP
			subs r5, acc32 ; Notch - LP is HP
			cpy_cc r6, acc32 ; save it
			multrr r7, acc32 ; Kf * HP
			adds r4, acc32 ; + BP
			cpy_mc bp, acc32 ; Save to BP
			cpy_mc lp, r3
			cpy_mc hp, r6
			cpy_mc notch, r5
		</code>
	</sub>
	<sub>
		<name>low_shelf</name>
		<desc>Low shelf filter using MREGs for in, out, K and S</desc>
		<param>
			<name>in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding input signal</desc>
		</param>
		<param>
			<name>k</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding filter frequency coefficient, range 0 to 1.0</desc>
		</param>
		<param>
			<name>s</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding shelf level, ranges 0 (cut) to 1.0 (boost)</desc>
		</param>
		<param>
			<name>del</name>
			<side>B</side>
			<type>MREG</type>
			<desc>MREG holding internal delay, do not overwrite/change</desc>
		</param>
		<param>
			<name>out</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG holding output</desc>
		</param>
		<code>
			/****************************************************
			*        Low shelf  
			*        
			*****************************************************/
			cpy_cm	r0, s
			addsi	r0, -0.5 	; shift to -0/5 to +0.5 range
			sls	acc32, 1 	; now -1.0 to +1.0 range
			cpy_cc	r0, acc32	; save S
			cpy_cm	r1, in		; Read in the input
			cpy_cm	r2, del		; read the delay
			multrr	r0, r2
			adds	acc32, r1
			cpy_mc	out, acc32
			cpy_cm	r3, k
			subs	r1, r2		; in - delay
			multrr	acc32, r3	; *K
			adds	acc32, r2	; + delay
			cpy_mc	del, acc32
		</code>
	</sub>
	<sub>
		<name>high_shelf</name>
		<desc>High shelf filter using MREGs for in, out, K and S</desc>
		<param>
			<name>in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding input signal</desc>
		</param>
		<param>
			<name>k</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding filter frequency coefficient, range 0 to 1.0</desc>
		</param>
		<param>
			<name>s</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding shelf level, ranges 0 (cut) to 1.0 (boost)</desc>
		</param>
		<param>
			<name>del</name>
			<side>B</side>
			<type>MREG</type>
			<desc>MREG holding internal delay, do not overwrite/change</desc>
		</param>
		<param>
			<name>out</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG holding output</desc>
		</param>
		<code>
			/****************************************************
			*        High shelf  
			*        
			*****************************************************/
			cpy_cm	r0, s
			addsi	r0, -0.5 	; shift to -0/5 to +0.5 range
			sls	acc32, 1 	; now -1.0 to +1.0 range
			cpy_cc	r0, acc32	; save S
			cpy_cm	r1, in		; Read in the input
			cpy_cm	r2, del		; read the delay
			cpy_cm	r3, k		; read in k
			subs	r1, r2
			multrr	acc32, r0
			adds	acc32, r1
			cpy_mc	out, acc32
			subs	r1, r2		; in - delay
			multrr	acc32, r3	; *K
			adds	acc32, r2	; + delay
			cpy_mc	del, acc32
		</code>
	</sub>
	<sub>
		<name>mr_^_n</name>
		<desc>MREG to the n power, MREG ranges 0 to 1.0, n is 1 to 7. Useful for making a linear value like a POT into an exponetial curve see AN-7 POT^n curves</desc>
		<param>
			<name>in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding input signal, ranges 0 to 1.0</desc>
		</param>
		<param>
			<name>n</name>
			<type>INT</type>
			<desc>Power to raise to, range 1 to 7</desc>
		</param>
		<param>
			<name>out</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG holding result</desc>
		</param>
		<code>
			/****************************************************
			*        MREG to the N power: MREG^N  
			*        
			*****************************************************/
			cpy_cm	r0, in
			log2	r0
			cpy_cc	r0, acc32
			wrdld	acc32, n
			sls	acc32, 12
			multrr	acc32, r0
			sls	acc32, 3
			exp2	acc32
			cpy_mc	out, acc32
		</code>
	</sub>
	<sub>
		<name>1-mr_^_n</name>
		<desc>1 - MREG to the n power, MREG ranges 0 to 1.0, n is 1 to 7. Useful for making a linear value like a POT into an exponetial curve see AN-7 1-(POT)^n curves</desc>
		<param>
			<name>in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding input signal, ranges 0 to 1.0</desc>
		</param>
		<param>
			<name>n</name>
			<type>INT</type>
			<desc>Power to raise to, range 1 to 7</desc>
		</param>
		<param>
			<name>out</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG holding result</desc>
		</param>
		<code>
			/****************************************************
			*        1 - MREG^N  
			*        
			*****************************************************/
			cpy_cm	r0, in
			wrdld	r1, 0x7fff
			ori	r1, 0xffff
			cpy_cc	r1, acc32
			log2	r0
			cpy_cc	r0, acc32
			wrdld	acc32, n
			sls	acc32, 12
			multrr	acc32, r0
			sls	acc32, 3
			exp2	acc32
			subs	r1, acc32
			cpy_mc	out, acc32
		</code>
	</sub>
	<sub>
		<name>_1-mr_^_n</name>
		<desc>MREG to the n power, MREG ranges 0 to 1.0, n is 1 to 7. Useful for making a linear value like a POT into an exponetial curve see AN-7 (1-POT)^n curves</desc>
		<param>
			<name>in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding input signal, ranges 0 to 1.0</desc>
		</param>
		<param>
			<name>n</name>
			<type>INT</type>
			<desc>Power to raise to, range 1 to 7</desc>
		</param>
		<param>
			<name>out</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG holding result</desc>
		</param>
		<code>
			/****************************************************
			*       (1-MREG) to the N power: (1-MREG)^N  
			*        
			*****************************************************/
			cpy_cm	r0, in
			wrdld	r1, 0x7fff
			ori	r1, 0xffff
			cpy_cc	r1, acc32
			subs	r1, r0
			log2	acc32
			cpy_cc	r0, acc32
			wrdld	acc32, n
			sls	acc32, 12
			multrr	acc32, r0
			sls	acc32, 3
			exp2	acc32
			cpy_mc	out, acc32
		</code>
	</sub>
	<sub>
		<name>1-1-mr_^_n</name>
		<desc>MREG to the n power, MREG ranges 0 to 1.0, n is 1 to 7. Useful for making a linear value like a POT into an exponetial curve see AN-7 1-(1-POT)^n curves</desc>
		<param>
			<name>in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding input signal, ranges 0 to 1.0</desc>
		</param>
		<param>
			<name>n</name>
			<type>INT</type>
			<desc>Power to raise to, range 1 to 7</desc>
		</param>
		<param>
			<name>out</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG holding result</desc>
		</param>
		<code>
			/****************************************************
			*        1 - (1-MREG) to the N power: 1 - (1-MREG)^N  
			*        
			*****************************************************/
			cpy_cm	r0, in
			wrdld	r1, 0x7fff
			ori	r1, 0xffff
			cpy_cc	r1, acc32
			subs	r1, r0
			log2	acc32
			cpy_cc	r0, acc32
			wrdld	acc32, n
			sls	acc32, 12
			multrr	acc32, r0
			sls	acc32, 3
			exp2	acc32
			subs	r1, acc32
			cpy_mc	out, acc32
		</code>
	</sub>
	<sub>
		<name>Band_Pass</name>
		<desc>State variable filter based bandpass, no input low pass but does have a low pass out due to nature of SVF</desc>
		<param>
			<name>sig_in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG to hold input signal to filter</desc>
		</param>
		<param>
			<name>freq</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG to control frequency point of filter, range 0 to 1.0</desc>
		</param>
		<param>
			<name>q</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG to control Q of filter, range 0 to 1.0</desc>
		</param>
		<param>
			<name>bp</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG to hold band-pass filter, do not overwrite/change</desc>
		</param>
		<param>
			<name>lp</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG to hold low-pass filter, do not overwrite/change</desc>
		</param>
		<code>
			/****************************************************
			*        State variable based band pass  
			*        
			*****************************************************/
			cpy_cm r7, freq
			cpy_cm r8, q	; actually this is D,which is 1/Q so invert pot sweep to make it act like a Q control
			wrdld acc32, 0x7fff ; put almost 1.0 into acc32
			ori acc32, 0xffff ; don't forget the LSBs
			subs acc32, r8 ; 1-pot in acc32
			cpy_cc r8, acc32
			cpy_cm r1, sig_in ; read in0 into temp
			cpy_cm r4, bp
			multrr r8, r4 ; Kd * BP
			subs r1, acc32 ; input - Kd*BP, this is the notch
			cpy_cc r5, acc32 ; save notch result
			multrr r7, r4 ; Kf * BP
			cpy_cm r3, lp
			adds r3, acc32 ; + LP
			cpy_cc r3, acc32 ; save to LP
			subs r5, acc32 ; Notch - LP is HP
			multrr r7, acc32 ; Kf * HP
			adds r4, acc32 ; + BP
			cpy_mc bp, acc32 ; Save to BP
			cpy_mc lp, r3
		</code>
	</sub>
	<sub>
		<name>graphic_eq_band</name>
		<desc>A filter for a single band of a graphic EQ, frequency, bandwidth and max gain/loss must be fixed parameters. NOTE requires pre-processor V2026.1 or newer, needs to support local .equ statements.</desc>
		<param>
			<name>fs</name>
			<type>DEC</type>
			<desc>Sample rate in Hz</desc>
		</param>
		<param>
			<name>fc</name>
			<type>DEC</type>
			<desc>Filter center frequency in Hz, make sure Fc/Fs is always &lt; 0.421875</desc>
		</param>
		<param>
			<name>bw</name>
			<type>DEC</type>
			<desc>Filter bandwidth in octaves</desc>
		</param>
		<param>
			<name>g_limit</name>
			<type>DEC</type>
			<desc>Max gain/loss in db, i.e a 12 here means a filter with +/-12 db gain/loss. 12db is max allowed</desc>
		</param>
		<param>
			<name>level</name>
			<side>T</side>
			<type>MREG</type>
			<desc>MREG that holds the level, ranges from 0 (-gain) to 0.999...(+gain), 0.5 means 0db gain</desc>
		</param>
		<param>
			<name>d1</name>
			<side>B</side>
			<type>MREG</type>
			<desc>MREG for first delay element</desc>
		</param>
		<param>
			<name>d2</name>
			<side>B</side>
			<type>MREG</type>
			<desc>MREG for second delay element</desc>
		</param>
		<param>
			<name>in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG for signal input</desc>
		</param>
		<param>
			<name>out</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG for signal output</desc>
		</param>
		<code>
			/******************************************************
			*  EQ filter band
			******************************************************/
			.equ	q	(2^(bw/2)/((2^bw)-1))
			.equ	r	1/q
			.equ	k	tan(pi()*fc/fs)
			.equ	max_g	10^(g_limit/20)
			; as r and k do not change after initial setting. unlike g and a, we can pre-calc some values
			.equ	rk	r*k
			.equ	k_sqr	k*k
			.equ	boost_denom	1/(1+rk+k_sqr)
			; in boost case m1 changes according to g but m2 and m3 do not so pre-calc them
			.equ	boost_m2	4*k_sqr*boost_denom
			.equ	boost_m3	(1-rk+k_sqr)*boost_denom
			
			; load K/4 into r1
			wrdld	r1, ((k/4)*(2^31-1))>>16
			ori	r1, ((k/4)*(2^31-1))&amp;0xffff 
			cpy_cc	r1, acc32
			jmp	calc_g

			calc_g:
			; load the max gain G/4 in decimal into r2, note scaled
			wrdld	r2, ((max_g/4)*(2^31-1))>>16
			ori	r2, ((max_g/4)*(2^31-1))&amp;0xffff
			cpy_cc	r2, acc32

			; Calculate A (which is G-1) below after scaling G by the POT
				
			; get the level, adjust it so it range 1 -> 0 -> 1 and decide if we are a cut or boost case
			cpy_cm	acc32, level	; get the level, 0 to 0.999 which is -max gain to +max gain
			addsi	acc32, -0.5	; shift range to -0.5 to +0.5
			cpy_cc	r13, acc32	; save a copy for later
			abs	acc32		; abs so 0.5 to 0 to 0.5
			adds	acc32, acc32	; *2 so now range 1.0 to 0 to 1.0
			cpy_cc	r14, acc32	; save a copy for later

			addsi	r2, -0.25	; g_max/4 - 1/4
			multrr	acc32, r14	; *
			addsi	acc32, 0x2000	; add 1/4
			cpy_cc	r2, acc32	; save it, this is G/4 in the equations, note overwriting g_max/4
			addsi	r2, -0.25	; A/4 = G/4 - 1/4
			cpy_cc	r3, acc32	; save it, this is A/4
			jgez	r13, boost_case	; jump if level was between 0.5 and 0.9999 as that is boost case


			; if here is a cut case
			; calculate denominator as common to all
			wrdld	acc32, ((rk/16)*(2^31-1))>>16		; load rk/16
			ori	acc32, ((rk/16)*(2^31-1))&amp;0xffff
			cpy_cc	r0, acc32	; save copy for m1/2
			multrr	acc32, r2	; * G/4
			cpy_cc	r8, acc32	; save it for M3 calc
			sra	r1, 1		; acc32 = K/8
			multrr	acc32, acc32	; (K/8)^2
			adds	acc32, r8	; add it all up
			addsi	acc32, 0x0200	; add 1/64
			log2	acc32		; get log2 as we need it later
			cpy_cc	r4, acc32


			; calculate M1/2
			multrr	r0, r3		; rk/16 * A/4
			sra	acc32, 1	; /2 as we need to calculate M1/2
			log2	acc32		; log domain
			subs	acc32, r4	; division by log subtraction
			exp2	acc32		; back to linear
			neg	acc32		; negate
			cpy_cc	r5, acc32	; M1/2 in r5

			; R5 : M1/2

			; calculate M2/4
			wrdld	acc32, ((k_sqr/64)*(2^31-1))>>16		; load k^2/64
			ori	acc32, ((k_sqr/64)*(2^31-1))&amp;0xffff
			cpy_cc	r9, acc32	; save for M3 calc
			log2	acc32		; log
			subs	acc32, r4
			exp2	acc32
			cpy_cc	r6, acc32	; M2/4 in r6

			; R6 : M2/4

			; calculate M3, can be negative or even 0 so check for this!
			xor	acc32, acc32	; zero out ACC32
			cpy_cc	r7, acc32	; preload a 0 incase we need it
			; r8 has GRK/64 from above
			; r9 has K^2/64
			adds	r8, r9		; add GRK +k^2
			cpy_cc	r8, acc32	; save it
			wrdld	acc32, 0x0200	; load "1"
			subs	acc32, r8	; 1 - GRK + K^2
			cpy_cc	r8, acc32	; save the result as we need to check sign
			jz	acc32, solve	; if result is 0, jump, note that r7 (m3) was already loaded with 0
			abs	r8
			log2	acc32
			subs	acc32, r4
			exp2	acc32
			jgez	r8, m3_pos	; jump if numerator was positive
			neg	acc32		; else negate result
		m3_pos:	cpy_cc	r7, acc32	; save result to r7
			jmp	solve		; jump over boost routine
			; R7: M3

		boost_case:
			
			wrdld	acc32, (boost_denom*(2^31-1))>>16	; load boost_denom
			ori	acc32, (boost_denom*(2^31-1))&amp;0xffff
			cpy_cc	r0, acc32
			wrdld	acc32, ((rk/4)*(2^31-1))>>16		; load rk/4
			ori	acc32, ((rk/4)*(2^31-1))&amp;0xffff
			multrr	acc32, r3			; *A/4
			multrr	acc32, r0			; * 1/denom
			sls	acc32, 3			; *8 to get to M1/2
			cpy_cc	r5, acc32
			; R5 : M1/2

			; load M2/4 into r6
			wrdld	acc32, ((boost_m2/4)*(2^31-1))>>16
			ori	acc32, ((boost_m2/4)*(2^31-1))&amp;0xffff 
			cpy_cc	r6, acc32
			; R6 : M2/4


			; load M3 into r7
			wrdld	acc32, (boost_m3*(2^31-1))>>16
			ori	acc32, (boost_m3*(2^31-1))&amp;0xffff 
			cpy_cc	r7, acc32
			; R7: M3


			; now solve the filter, use r0, r1 and r2 as we are done with them
		solve:	cpy_cm	r0, in
			cpy_cm	r1, d1
			cpy_cm	r2, d2
			adds	r0, r2		; IN + D2
			subs	acc32, r1	; -D1
			cpy_cc	r3, acc32	; R3 = P
			multrr	acc32, r6	; P*M2/4
			sls	acc32, 2	; *4
			adds	acc32, r1	; +D1
			cpy_cc	r1, acc32	; new D1 in R1
			multrr	r7, r3		; M3*P
			adds	acc32, r0	; +IN
			cpy_cc	r2, acc32	; new D2 in R2
			multrr	r5, r3		; M1/2*P
			sls	acc32, 1	; *2
			adds	acc32, r0	; +IN
			cpy_mc	out, acc32	; write output
			cpy_mc	d1, r1		; save D1
			cpy_mc	d2, r2		; save D2
		</code>
	</sub>
</library>
